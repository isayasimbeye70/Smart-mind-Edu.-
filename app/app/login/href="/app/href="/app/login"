"use client";
import { useState } from "react";
import Link from "next/link";

export default function Login() {
  const [role, setRole] = useState("mwanafunzi");
  const [user, setUser] = useState("");
  const [pass, setPass] = useState("");
  return (
    <div style={{minHeight:'100vh',background:'#0f172a',color:'white',display:'flex',alignItems:'center',justifyContent:'center',padding:'20px'}}>
      <div style={{background:'white',color:'black',padding:'30px',borderRadius:'20px',width:'100%',maxWidth:'400px'}}>
        <Link href="/app" style={{color:'#64748b',textDecoration:'none'}}>← Rudi Nyumbani</Link>
        <h1 style={{fontSize:'28px',fontWeight:'bold',marginTop:'20px',textAlign:'center'}}>🧠 SmartMind Edu</h1>
        <h2 style={{textAlign:'center',marginTop:'10px',color:'#334155'}}>Ingia</h2>
        <div style={{display:'flex',gap:'10px',marginTop:'20px'}}>
          <button onClick={()=>setRole('mwanafunzi')} style={{flex:1,padding:'10px',borderRadius:'10px',border:'none',background: role==='mwanafunzi' ? '#0f172a':'#e2e8f0',color: role==='mwanafunzi' ? 'white':'black',fontWeight:'bold'}}>🎓 Mwanafunzi</button>
          <button onClick={()=>setRole('mwalimu')} style={{flex:1,padding:'10px',borderRadius:'10px',border:'none',background: role==='mwalimu' ? '#facc15':'#e2e8f0',color:'black',fontWeight:'bold'}}>👨‍🏫 Mwalimu</button>
        </div>
        <form onSubmit={e=>{e.preventDefault(); alert(`Karibu ${user}!`); location.href='/app/dashboard'}} style={{marginTop:'25px'}}>
          <input value={user} onChange={e=>setUser(e.target.value)} placeholder="Jina la mtumiaji" required style={{width:'100%',padding:'12px',borderRadius:'10px',border:'1px solid #cbd5e1',marginBottom:'15px'}}/>
          <input type="password" value={pass} onChange={e=>setPass(e.target.value)} placeholder="Neno la siri" required style={{width:'100%',padding:'12px',borderRadius:'10px',border:'1px solid #cbd5e1',marginBottom:'20px'}}/>
          <button type="submit" style={{width:'100%',padding:'14px',background:'#0f172a',color:'white',borderRadius:'10px',border:'none',fontWeight:'bold'}}>Ingia Sasa 🚀</button>
        </form>
      </div>
    </div>
  )
}
